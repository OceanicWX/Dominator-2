    if isSeated or not localPlayer.Character then return end local hrp, hum = localPlayer.Character:FindFirstChild("HumanoidRootPart"), localPlayer.Character:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then
        isSeated = true hrp.CFrame, hum.Sit = prim.CFrame * CFrame.new(0.6, 2.1, 0.85), true
