RS.Heartbeat:Connect(function(dt)
    if not mdl or not mdl.Parent or not prim then return end local cam = W.CurrentCamera
    
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    
    local isDriving = (humanoid and seat and humanoid.SeatPart == seat)
    local isNearChassis = (hrp and (hrp.Position - prim.Position).Magnitude <= 6)
    
    if isDriving or isNearChassis then
        if d.SG then d.SG.Enabled = true end
        if d.PUI then d.PUI.Enabled = true end
        if not driveState.globalUIHidden then
            if d.MU then d.MU.Visible = true end
        end
    else
        if d.MU then d.MU.Visible = false end
        if d.SG then d.SG.Enabled = false end
        if d.PUI then d.PUI.Enabled = false end
    end
    
    local withinProximity = hrp and (hrp.Position - prim.Position).Magnitude <= 5
    if cam and (isSeated or withinProximity) then
        local distanceToChassis = (cam.CFrame.Position - prim.Position).Magnitude
        if distanceToChassis <= 5.5 then
            muffleEQ.HighGain, muffleEQ.MidGain, muffleEQ.LowGain = -32, -18, -4
        else
            muffleEQ.HighGain, muffleEQ.MidGain, muffleEQ.LowGain = 0, 0, 0
        end
    else
        muffleEQ.HighGain, muffleEQ.MidGain, muffleEQ.LowGain = 0, 0, 0
    end
    
    if driveState.currentSpikeDistance > 0 then
        driveState.forward, driveState.reverse, driveState.left, driveState.right = false, false, false, false
        driveState.currentSpeed = 0
        if lv and av then lv.VectorVelocity, av.AngularVelocity = Vector3.zero, Vector3.zero end
        d.ST.Text = "000"
        return
    end
    
    if isSeated and prim and prim.Parent and not driveState.deployed then
        local cLook = prim.CFrame.LookVector local absSp = math.abs(driveState.currentSpeed)
        local ray = Ray.new(prim.Position, Vector3.new(0, -6, 0)) local hitPart = W:FindPartOnRayWithIgnoreList(ray, {mdl, localPlayer.Character})
        local isOff = false
        if hitPart and hitPart.Material == Enum.Material.Grass then
            isOff = true
        end
        local maxS = isOff and 55 or 75 local maxR = isOff and -20 or -28
        local fFactor = math.clamp(1 - (absSp / maxS), 0.15, 1.0) local rFactor = math.clamp(1 - (absSp / math.abs(maxR)), 0.25, 1.0)
        if driveState.brake then driveState.currentSpeed = driveState.currentSpeed > 0 and math.max(0, driveState.currentSpeed - BRAKE_FACTOR) or math.min(0, driveState.currentSpeed + BRAKE_FACTOR)
        elseif driveState.forward and not driveState.engineKillOverride then driveState.currentSpeed = math.min(maxS, driveState.currentSpeed + (1.15 * fFactor))
        elseif driveState.reverse and not driveState.engineKillOverride then driveState.currentSpeed = math.max(maxR, driveState.currentSpeed - (0.65 * rFactor))
        else
            if driveState.currentSpeed > maxS then driveState.currentSpeed = math.max(maxS, driveState.currentSpeed - 1.8)
